      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(http_requests_total{job=~\"$job\"}[$__rate_interval])) by (job)", "legendFormat": "{{job}}", "refId": "A" }],
