      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 * sum(rate(http_requests_total{job=~\"$job\",code=~\"5..\"}[$__rate_interval])) by (job) / sum(rate(http_requests_total{job=~\"$job\"}[$__rate_interval])) by (job)", "legendFormat": "{{job}}", "refId": "A" }],
      "title": "Errors – 5xx Error Rate %",
